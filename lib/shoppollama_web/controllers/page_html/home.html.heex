<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex flex-col">
  <!-- Header -->
  <header class="bg-black/30 backdrop-blur-sm border-b border-purple-500/30 p-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">S</span>
        </div>
        <h1 class="text-white text-xl font-bold">ShoppOllama</h1>
        <span class="text-purple-300 text-sm">AI-Powered Shopify Assistant</span>
      </div>
      <div class="flex items-center space-x-4">
        <div class="bg-green-500/20 border border-green-500/30 rounded-full px-3 py-1">
          <span class="text-green-400 text-xs font-medium">● gpt-oss:20b Ready</span>
        </div>
        <button class="bg-purple-600/80 hover:bg-purple-600 text-white px-4 py-2 rounded-lg font-medium transition-colors">
          Connect Store
        </button>
      </div>
    </div>
  </header>
  
<!-- Main Chat Area -->
  <div class="flex-1 flex flex-col max-w-4xl mx-auto w-full p-6">
    <!-- Welcome Message -->
    <div class="mb-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-2">Welcome to ShoppOllama</h2>
      <p class="text-gray-300">Your AI assistant for Shopify store management and automation</p>
    </div>
    
<!-- Chat Messages Area -->
    <div class="flex-1 bg-black/20 backdrop-blur-sm rounded-2xl border border-purple-500/20 p-6 mb-6 overflow-y-auto">
      <!-- AI Introduction Message -->
      <div class="flex items-start space-x-3 mb-6">
        <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs font-bold">AI</span>
        </div>
        <div class="bg-purple-900/30 border border-purple-500/20 rounded-2xl rounded-tl-none p-4 max-w-lg">
          <p class="text-gray-200 leading-relaxed">
            Hi! I'm your ShoppOllama assistant. I can help you:
          </p>
          <ul class="text-gray-300 mt-3 space-y-1 text-sm">
            <li>• Analyze your store data and metrics</li>
            <li>• Automate inventory management</li>
            <li>• Generate product descriptions</li>
            <li>• Handle customer support queries</li>
            <li>• Optimize your store performance</li>
          </ul>
          <p class="text-gray-400 text-xs mt-3">
            Connect your Shopify store to get started, or just ask me anything!
          </p>
        </div>
      </div>
      
<!-- Suggested Actions -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button class="bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-200 px-4 py-2 rounded-lg text-sm transition-colors">
          "Connect my Shopify store"
        </button>
        <button class="bg-cyan-600/20 hover:bg-cyan-600/30 border border-cyan-500/30 text-cyan-200 px-4 py-2 rounded-lg text-sm transition-colors">
          "Analyze my sales data"
        </button>
        <button class="bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-200 px-4 py-2 rounded-lg text-sm transition-colors">
          "Generate product descriptions"
        </button>
      </div>
    </div>
    
<!-- Chat Input -->
    <div class="bg-black/30 backdrop-blur-sm rounded-2xl border border-purple-500/20 p-4">
      <div class="flex items-center space-x-4">
        <div class="flex-1 relative">
          <input
            type="text"
            placeholder="Ask ShoppOllama anything about your store..."
            class="w-full bg-gray-800/50 border border-gray-600/50 rounded-xl px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:border-purple-500/50 focus:ring-2 focus:ring-purple-500/20"
          />
        </div>
        <button class="bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-700 hover:to-cyan-700 text-white p-3 rounded-xl transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
            >
            </path>
          </svg>
        </button>
      </div>
      
<!-- Model Selector -->
      <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-600/30">
        <div class="flex items-center space-x-3">
          <span class="text-gray-400 text-xs">Model:</span>
          <select class="bg-gray-800/50 border border-gray-600/50 rounded-lg px-3 py-1 text-white text-sm focus:outline-none focus:border-purple-500/50">
            <option>gpt-oss:20b (Fast)</option>
            <option>gpt-oss:120b (Advanced)</option>
          </select>
          <span class="text-gray-400 text-xs">Reasoning:</span>
          <select class="bg-gray-800/50 border border-gray-600/50 rounded-lg px-3 py-1 text-white text-sm focus:outline-none focus:border-purple-500/50">
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
          </select>
        </div>
        <div class="flex items-center space-x-2 text-xs text-gray-400">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span>Ollama Connected</span>
        </div>
      </div>
    </div>
  </div>
</div>
