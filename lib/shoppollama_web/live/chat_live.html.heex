local did_change = false

for line in lines do
  -- escape special chars with % when matching literally, ie:: `%^  %$  %(  %)  %%  %.  %[  %]  %*  %+  %-  %?`
  if line:match('^%s*<div class="flex items%-start space%-x%-3 mt%-4">%s*$') then
    -- add data-testid to the thinking indicator div
    print('          <div class="flex items-start space-x-3 mt-4" data-testid="thinking">')
    did_change = true
  else
    print(line)
  end
end
<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex flex-col">
    <!-- Header -->
    <header class="bg-black/30 backdrop-blur-sm border-b border-purple-500/30 p-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">S</span>
          </div>
          <h1 class="text-white text-xl font-bold">ShoppOllama</h1>
          <span class="text-purple-300 text-sm">AI Commerce Assistant</span>
        </div>
        <div class="flex items-center space-x-4">
          <div class="bg-green-500/20 border border-green-500/30 rounded-full px-3 py-1">
            <span class="text-green-400 text-xs font-medium">
              <%= if @ollama_connected do %>
                ● {@selected_model} Ready
              <% else %>
                ● Ollama Disconnected
              <% end %>
            </span>
          </div>
          <button class={[
            "px-4 py-2 rounded-lg font-medium transition-colors",
            if(@store_connected,
              do: "bg-green-600/80 hover:bg-green-600 text-white",
              else: "bg-purple-600/80 hover:bg-purple-600 text-white"
            )
          ]}>
            {if @store_connected, do: "Store Connected", else: "Connect Store"}
          </button>
        </div>
      </div>
    </header>
    
<!-- Main Chat Area -->
    <div class="flex-1 flex flex-col max-w-4xl mx-auto w-full p-6">
      <!-- Chat Messages Area -->
      <div
        class="flex-1 bg-black/20 backdrop-blur-sm rounded-2xl border border-purple-500/20 p-6 mb-6 overflow-y-auto"
        id="chat-messages"
      >
        <!-- Messages Stream -->
        <div id="messages" phx-update="stream" class="space-y-4">
          <div
            :for={{id, message} <- @streams.messages}
            id={id}
            class="flex items-start space-x-3"
          >
            <div class={[
              "w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0",
              if(message.role == :user,
                do: "bg-gradient-to-r from-cyan-500 to-blue-500",
                else: "bg-gradient-to-r from-purple-500 to-cyan-500"
              )
            ]}>
              <span class="text-white text-xs font-bold">
                {if message.role == :user, do: "U", else: "AI"}
              </span>
            </div>
            <div class={[
              "rounded-2xl p-4 max-w-3xl",
              if(message.role == :user,
                do: "bg-cyan-900/30 border border-cyan-500/20 rounded-tr-none",
                else: "bg-purple-900/30 border border-purple-500/20 rounded-tl-none"
              )
            ]}>
              <p class="text-gray-200 leading-relaxed whitespace-pre-wrap">{message.content}</p>
              <div class="flex items-center justify-between mt-2 text-xs text-gray-400">
                <span>{Calendar.strftime(message.timestamp, "%I:%M %p")}</span>
                <%= if message.role == :assistant && Map.has_key?(message, :model) do %>
                  <span class="bg-purple-600/20 px-2 py-1 rounded-full">{message.model}</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        
<!-- Thinking Indicator -->
        <%= if @thinking do %>
          <div class="flex items-start space-x-3 mt-4" data-testid="thinking">
            <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-white text-xs font-bold">AI</span>
            </div>
            <div class="bg-purple-900/30 border border-purple-500/20 rounded-2xl rounded-tl-none p-4">
              <div class="flex items-center space-x-2 text-gray-300">
                <div class="flex space-x-1">
                  <div class="w-2 h-2 bg-purple-400 rounded-full animate-pulse"></div>
                  <div
                    class="w-2 h-2 bg-purple-400 rounded-full animate-pulse"
                    style="animation-delay: 0.2s"
                  >
                  </div>
                  <div
                    class="w-2 h-2 bg-purple-400 rounded-full animate-pulse"
                    style="animation-delay: 0.4s"
                  >
                  </div>
                </div>
                <span class="text-sm">ShoppOllama is thinking...</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
<!-- Chat Input -->
      <div class="bg-black/30 backdrop-blur-sm rounded-2xl border border-purple-500/20 p-4">
        <.form for={%{}} id="chat-form" phx-submit="send_message" class="contents">
          <div class="flex items-center space-x-4">
            <div class="flex-1 relative">
              <input
                type="text"
                name="message"
                value={@current_message}
                phx-change="update_message"
                placeholder="Ask ShoppOllama anything about your store..."
                class="w-full bg-gray-800/50 border border-gray-600/50 rounded-xl px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:border-purple-500/50 focus:ring-2 focus:ring-purple-500/20"
                autocomplete="off"
              />
            </div>
            <button
              type="submit"
              disabled={@thinking || @current_message == ""}
              class="bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-700 hover:to-cyan-700 disabled:opacity-50 disabled:cursor-not-allowed text-white p-3 rounded-xl transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                >
                </path>
              </svg>
            </button>
          </div>
        </.form>
        
<!-- Model Selector -->
        <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-600/30">
          <div class="flex items-center space-x-3">
            <span class="text-gray-400 text-xs">Model:</span>
            <select
              phx-change="select_model"
              name="model"
              class="bg-gray-800/50 border border-gray-600/50 rounded-lg px-3 py-1 text-white text-sm focus:outline-none focus:border-purple-500/50"
            >
              <option value="gpt-oss:20b" selected={@selected_model == "gpt-oss:20b"}>
                gpt-oss:20b (Fast)
              </option>
              <option value="gpt-oss:120b" selected={@selected_model == "gpt-oss:120b"}>
                gpt-oss:120b (Advanced)
              </option>
            </select>
            <span class="text-gray-400 text-xs">Reasoning:</span>
            <select
              phx-change="select_reasoning"
              name="reasoning"
              class="bg-gray-800/50 border border-gray-600/50 rounded-lg px-3 py-1 text-white text-sm focus:outline-none focus:border-purple-500/50"
            >
              <option value="low" selected={@reasoning_effort == "low"}>Low</option>
              <option value="medium" selected={@reasoning_effort == "medium"}>Medium</option>
              <option value="high" selected={@reasoning_effort == "high"}>High</option>
            </select>
          </div>
          <div class="flex items-center space-x-2 text-xs text-gray-400">
            <div class={[
              "w-2 h-2 rounded-full",
              if(@ollama_connected, do: "bg-green-500 animate-pulse", else: "bg-red-500")
            ]}>
            </div>
            <span>
              {if @ollama_connected, do: "Ollama Connected", else: "Ollama Disconnected"}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
