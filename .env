# Shopify Configuration
# Add your Shopify access token here to enable product creation
# You can get this from your Shopify app's admin panel

# Replace with your actual access token from Shopify
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# Your store domain (already configured in the code)
SHOPIFY_STORE_DOMAIN=silicon-valley-shirts.myshopify.com

# Your Shopify app credentials
SHOPIFY_CLIENT_ID=356e5aa3ba68f30312214f7cfdfd92da
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Instructions:
# 1. Replace 'your_access_token_here' with your actual Shopify access token
# 2. Replace 'your_client_secret_here' with your actual client secret
# 3. Restart the Phoenix server after making changes
# 4. Test by typing "Create a black t-shirt for $25" in the chat

# Note: The refresh token is temporary (1 hour) and used for OAuth flows
# For direct API access, you need the access token
